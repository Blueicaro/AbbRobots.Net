<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2000/xaml"
        xmlns:vm="using:AbbRobots.Net.Gui.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
        x:Class="AbbRobots.Net.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ABB Robots .NET - EIO Parser Grid"
        Width="850" Height="500"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto, *, Auto" Margin="15">
        
        <StackPanel GridRow="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="📥 Cargar Fichero EIO.cfg" 
                    Command="{Binding CargarArchivoCommand}" 
                    Padding="10,6" 
                    Background="#2196F3" 
                    Foreground="White"
                    FontWeight="Bold"/>
        </StackPanel>

        <DataGrid GridRow="1" 
                  ItemsSource="{Binding Signals}" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  GridLinesVisibility="All"
                  BorderThickness="1" 
                  BorderBrush="Gray">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre de Señal" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding SignalType}" Width="1*"/>
                <DataGridTextColumn Header="Tarjeta / Unidad" Binding="{Binding Device}" Width="1.5*"/>
                <DataGridTextColumn Header="Mapeo Direccionamiento" Binding="{Binding DeviceMap}" Width="1.5*"/>
                <DataGridTextColumn Header="Invertida" Binding="{Binding Invert}" Width="0.8*"/>
                <DataGridTextColumn Header="Etiqueta" Binding="{Binding Label}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock GridRow="2" 
                   Text="{Binding StatusMessage}" 
                   Margin="0,10,0,0" 
                   FontStyle="Italic" 
                   Foreground="Gray"/>
    </Grid>
</Window>